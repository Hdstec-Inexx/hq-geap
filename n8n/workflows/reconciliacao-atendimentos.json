      "id": "8e0e5561-d5a1-4e3b-9bad-d3316ed1462d",
      "name": "Baixar áudio ElevenLabs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -180
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_NO_N8N",
          "name": "ElevenLabs API Key"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nif (!item.binary?.data) return [{ json: { ...item.json, audio_downloaded: false } }];\nitem.binary.data.mimeType = 'audio/mpeg';\nreturn [{ json: { ...item.json, audio_downloaded: true }, binary: item.binary }];"
      },
      "id": "55cf6cc1-2c7d-48fc-bc1e-8d84bc2d19ce",

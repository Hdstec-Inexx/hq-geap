        "mode": "runOnceForAllItems",
        "jsCode": "const normalized = $items('Contrato normalizado')[0].json;\nconst { has_audio, audio_object_key, ...payload } = normalized;\nconst isSuccess = has_audio === true && Boolean($json) && !$json.error && $json.audio_downloaded !== false;\nconst audio_reference = isSuccess ? audio_object_key : null;\nreturn [{ json: { ...payload, audio_reference } }];"
      },

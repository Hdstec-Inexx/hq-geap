      "id": "917b82e4-f1ea-4804-a51b-5deaf2df299f",
      "name": "Rejeitar assinatura",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        660,
        180
      ]

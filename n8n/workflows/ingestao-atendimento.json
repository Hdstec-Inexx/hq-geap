      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "hq-geap-atendimentos"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { createHmac, timingSafeEqual } = require('crypto');\nconst item = $input.first();\nconst rawBody = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst header = item.json.headers?.['elevenlabs-signature'];\nconst secret = $env.ELEVENLABS_WEBHOOK_SECRET;\nif (!header || !secret) return [{ json: { valid: false } }];\nconst parts = header.split(',');\nconst timestamp = parts.find(part => part.startsWith('t='))?.slice(2);\nconst signature = parts.find(part => part.startsWith('v0='))?.slice(3);\nif (!timestamp || !signature || !/^[0-9a-f]{64}$/.test(signature)) return [{ json: { valid: false } }];\nconst timestampMs = Number(timestamp) * 1000;\nif (!Number.isFinite(timestampMs) || timestampMs < Date.now() - 30 * 60_000 || timestampMs > Date.now() + 5 * 60_000) return [{ json: { valid: false } }];\nconst expected = createHmac('sha256', secret).update(`${timestamp}.${rawBody}`, 'utf8').digest();\nconst supplied = Buffer.from(signature, 'hex');\nif (supplied.length !== expected.length || !timingSafeEqual(supplied, expected)) return [{ json: { valid: false } }];\ntry {\n  return [{ json: { valid: true, event: JSON.parse(rawBody) } }];\n} catch {\n  return [{ json: { valid: false } }];\n}"
      },

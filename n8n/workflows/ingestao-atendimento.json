    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const event = $json.event;\nif (event?.type !== 'post_call_transcription') throw new Error('Unsupported ElevenLabs event');\nconst data = event.data;\nconst transferToolName = $env.ELEVENLABS_TRANSFER_TOOL_NAME;\nif (!transferToolName) throw new Error('ELEVENLABS_TRANSFER_TOOL_NAME is required');\nconst startedAt = new Date(data.metadata.start_time_unix_secs * 1000);\nconst duration = data.metadata.call_duration_secs;\nconst contactReason = data.analysis?.data_collection_results?.['Classificação']?.value ?? null;\nconst transferred = data.transcript.some(turn => turn.tool_calls?.some(call => call.tool_name === transferToolName && call.tool_has_been_called === true));\n\nconst firstAgentSpeech = data.transcript.find(turn => turn.role === 'agent' && String(turn.message ?? '').trim());\nconst tme_seconds = firstAgentSpeech && Number.isFinite(Number(firstAgentSpeech.time_in_call_secs))\n  ? Number(firstAgentSpeech.time_in_call_secs)\n  : null;\nconst resultsByCallId = new Map();\nfor (const turn of data.transcript) {\n  for (const result of turn.tool_results ?? []) {\n    if (result?.tool_call_id) resultsByCallId.set(result.tool_call_id, result);\n  }\n}\nconst executions = [];\nfor (const turn of data.transcript) {\n  for (const call of turn.tool_calls ?? []) {\n    if (call?.tool_has_been_called !== true) continue;\n    const result = call.tool_call_id ? resultsByCallId.get(call.tool_call_id) : undefined;\n    // Sucesso só com tool_result explícito e sem erro (US12 / Taxa de Promessas Cumpridas).\n    const success = Boolean(result) && result.is_error !== true;\n    executions.push({ success });\n  }\n}\nreturn [{ json: {\n  conversation_id: data.conversation_id,\n  agent_id: data.agent_id,\n  event_timestamp: event.event_timestamp,\n  status: data.status === 'done' ? 'concluido' : 'em_andamento',\n  started_at: startedAt.toISOString(),\n  completed_at: data.status === 'done' ? new Date(startedAt.getTime() + duration * 1000).toISOString() : null,\n  duration_seconds: duration,\n  transcript: data.transcript.filter(turn => turn.role === 'agent' || turn.role === 'user').map(({ role, message, time_in_call_secs }) => ({ role, message: message ?? '', time_in_call_secs })),\n  contact_reason: contactReason,\n  transferred,\n  cost: data.metadata.cost_fiat ?? null,\n  tme_seconds,\n  tool_executions: { total: executions.length, successful: executions.filter(item => item.success).length },\n  has_audio: data.has_audio === true,\n  audio_object_key: `atendimentos/${data.conversation_id}.mp3`\n} }];"
      },

{
  "name": "HQ GEAP - Buscar Conversa",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Buscar Conversa",
        "formDescription": "Informe o conversation_id da ElevenLabs para reprocessar o Atendimento.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "conversation_id",
              "fieldName": "conversation_id",
              "fieldType": "text",
              "requiredField": true
            }
          ]
        },
        "options": {
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Atendimento enviado para ingestão."
            }
          }
        }
      },
      "id": "c57ca635-cbd5-40be-a677-4efaf8b9800c",
      "name": "Buscar Conversa",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "webhookId": "hq-geap-buscar-conversa"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const conversationId = String($json.conversation_id ?? '').trim();\nif (!conversationId || conversationId.length > 255 || !/^[A-Za-z0-9_-]+$/.test(conversationId)) throw new Error('conversation_id inválido');\nreturn [{ json: { conversation_id: conversationId } }];"
      },
      "id": "7cfab9ad-b63e-4691-a705-38b39439bbf2",
      "name": "Validar conversation_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ ($env.ELEVENLABS_API_URL || 'https://api.elevenlabs.io') + '/v1/convai/conversations/' + encodeURIComponent($json.conversation_id) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "725f73ab-e8ab-44ec-a15c-acf0e42549c5",
      "name": "Buscar Conversa ElevenLabs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_NO_N8N",
          "name": "ElevenLabs API Key"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const data = $json;\nif (data?.status !== 'done') throw new Error('Somente Atendimentos concluídos podem ser ingeridos');\nconst transferToolName = $env.ELEVENLABS_TRANSFER_TOOL_NAME;\nif (!transferToolName) throw new Error('ELEVENLABS_TRANSFER_TOOL_NAME is required');\nconst startedAt = new Date(data.metadata.start_time_unix_secs * 1000);\nconst duration = data.metadata.call_duration_secs;\nconst contactReason = data.analysis?.data_collection_results?.['Classificação']?.value ?? null;\nconst transferred = data.transcript.some(turn => turn.tool_calls?.some(call => call.tool_name === transferToolName && call.tool_has_been_called === true));\n\nconst agentSpeeches = data.transcript.filter(turn => turn.role === 'agent' && String(turn.message ?? '').trim());\nconst firstClientSpeech = data.transcript.find(turn => turn.role === 'user' && String(turn.message ?? '').trim());\nconst secondAgentSpeech = agentSpeeches[1];\nlet tme_seconds = null;\nif (agentSpeeches[0] && secondAgentSpeech && firstClientSpeech) {\n  const clientAt = Number(firstClientSpeech.time_in_call_secs);\n  const secondAgentAt = Number(secondAgentSpeech.time_in_call_secs);\n  if (Number.isFinite(clientAt) && Number.isFinite(secondAgentAt)) {\n    const delta = secondAgentAt - clientAt;\n    if (delta >= 0) tme_seconds = Math.round(delta);\n  }\n}\nconst resultsByCallId = new Map();\nfor (const turn of data.transcript) {\n  for (const result of turn.tool_results ?? []) {\n    if (result?.tool_call_id) resultsByCallId.set(result.tool_call_id, result);\n  }\n}\nconst executions = [];\nfor (const turn of data.transcript) {\n  for (const call of turn.tool_calls ?? []) {\n    if (call?.tool_has_been_called !== true) continue;\n    const result = call.tool_call_id ? resultsByCallId.get(call.tool_call_id) : undefined;\n    // Sucesso só com tool_result explícito e sem erro (US12 / Taxa de Promessas Cumpridas).\n    const success = Boolean(result) && result.is_error !== true;\n    executions.push({ success });\n  }\n}\nreturn [{ json: {\n  conversation_id: data.conversation_id,\n  agent_id: data.agent_id,\n  event_timestamp: data.metadata.start_time_unix_secs + duration,\n  status: 'concluido',\n  started_at: startedAt.toISOString(),\n  completed_at: new Date(startedAt.getTime() + duration * 1000).toISOString(),\n  duration_seconds: duration,\n  transcript: data.transcript.filter(turn => turn.role === 'agent' || turn.role === 'user').map(({ role, message, time_in_call_secs }) => ({ role, message: message ?? '', time_in_call_secs })),\n  audio_reference: null,\n  contact_reason: contactReason,\n  transferred,\n  cost: data.metadata.cost_fiat ?? null,\n  tme_seconds,\n  tool_executions: { total: executions.length, successful: executions.filter(item => item.success).length },\n  has_audio: data.has_audio === true,\n  audio_object_key: `${data.conversation_id}.mp3`\n} }];"
      },
      "id": "aec5f1f4-8028-435a-aa3e-0df4dabf05d1",
      "name": "Contrato normalizado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HQ_API_URL }}/atendimentos/ingestao",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "4373c31f-6ffe-4aeb-a01c-1cb2c1f8d772",
      "name": "Persistir Atendimento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_NO_N8N",
          "name": "HQ Ingestion API Key"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const normalized = $items('Contrato normalizado')[0].json;\nconst { has_audio, audio_object_key, ...payload } = normalized;\nconst audio_reference = has_audio === true && $json?.success === true ? audio_object_key : null;\nreturn [{ json: { ...payload, audio_reference } }];"
      },
      "id": "f979572c-28a2-4ad8-a2a8-36b93153bef0",
      "name": "Preparar contrato API",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        -80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-audio",
              "leftValue": "={{ $('Contrato normalizado').item.json.has_audio }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3ab77410-d251-4471-a194-d1fd18999ac2",
      "name": "Possui áudio?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        -80
      ]
    },
    {
      "parameters": {
        "url": "={{ ($env.ELEVENLABS_API_URL || 'https://api.elevenlabs.io') + '/v1/convai/conversations/' + $('Contrato normalizado').item.json.conversation_id + '/audio' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",

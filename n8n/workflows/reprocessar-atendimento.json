              "id": "audio-downloaded",
              "leftValue": "={{ $json.audio_downloaded }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "878d4b95-2b28-4d78-879e-2709d60725d4",
      "name": "Áudio baixado?",

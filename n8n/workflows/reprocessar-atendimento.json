      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_NO_N8N",
          "name": "ElevenLabs API Key"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nif (!item.binary?.data) return [{ json: { ...item.json, audio_downloaded: false } }];\nitem.binary.data.mimeType = 'audio/mpeg';\nreturn [{ json: { ...item.json, audio_downloaded: true }, binary: item.binary }];"
      },
      "id": "55cf6cc1-2c7d-48fc-bc1e-8d84bc2d19ce",
      "name": "Definir Content-Type do áudio",

# Banco de dados (PostgreSQL)
DATABASE_URL=postgres://hq_geap:hq_geap@127.0.0.1:5432/hq_geap
TEST_DATABASE_URL=postgres://hq_geap:hq_geap@127.0.0.1:5432/hq_geap_test

# Aplicações locais
# Em produção (Easypanel) o default é 0.0.0.0 quando NODE_ENV=production.
HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=http://localhost:5173
# URL pública da API embutida no build da Web (build arg de Dockerfile.web).
VITE_API_URL=http://localhost:3000
# Em produção, após o primeiro seed: SKIP_DB_SEED=1
# SKIP_DB_SEED=0
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800
INGESTION_API_KEY=
# O MinIO local usa URLs assinadas; em produção use MinIO/GCS ou outro storage assinado.
STORAGE_PROVIDER=minio
STORAGE_BUCKET=hq-geap
STORAGE_PUBLIC_URL=http://127.0.0.1:9000/hq-geap
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Monitoramento ao Vivo (API do HQ — chave fica só no servidor)
# Obrigatória em produção. Sem ela, o monitoramento falha de forma explícita.
ELEVENLABS_API_KEY=
# ELEVENLABS_API_URL=https://api.elevenlabs.io

# A Credential `ElevenLabs API Key` do n8n continua só para ingestão/reconciliação.
# A chave do OpenRouter e a credencial de escrita da Avaliação da IA também
# pertencem ao Credentials do n8n. DATABASE_URL é a credencial própria do HQ.
#
# Deploy Easypanel: ver docs/deploy/easypanel.md (Dockerfile + Dockerfile.web).

# Copie para as Environment Variables do serviço Compose no Easypanel.
# Sem este conjunto completo a API fica unhealthy (web não sobe).
# PostgreSQL é externo — use o host/rede do DB já provisionado (não há serviço `db` neste Compose).

DATABASE_URL=postgres://USER:PASSWORD@HOST_DO_DB:5432/hq_geap

CORS_ORIGIN=https://hq.seudominio.com
VITE_API_URL=https://api.seudominio.com

# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-segredo-com-pelo-menos-32-chars!!
INGESTION_API_KEY=troque-por-chave-com-pelo-menos-32-chars!

ELEVENLABS_API_KEY=sk_...

# Nunca use public em produção
STORAGE_PROVIDER=minio
STORAGE_BUCKET=hq-geap
STORAGE_ENDPOINT=https://minio.seudominio.com
STORAGE_ACCESS_KEY=...
STORAGE_SECRET_KEY=...
STORAGE_PUBLIC_URL=https://minio.seudominio.com/hq-geap

# Cloudflare R2 (opcional — cold storage para tiering de Atendimentos)
# Se configurado, todas as 4 variáveis são obrigatórias e R2_ENDPOINT exige HTTPS
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=hq-geap-cold
# R2_ACCESS_KEY=...
# R2_SECRET_KEY=...

# Depois do primeiro deploy bem-sucedido:
# SKIP_DB_SEED=1

# Copie para as Environment Variables do serviço Compose no Easypanel.
# Sem este conjunto completo a API fica unhealthy (web não sobe).

POSTGRES_DB=hq_geap
POSTGRES_USER=hq_geap
POSTGRES_PASSWORD=troque-por-senha-forte-do-postgres
DATABASE_URL=postgres://hq_geap:troque-por-senha-forte-do-postgres@db:5432/hq_geap

CORS_ORIGIN=https://hq.seudominio.com
VITE_API_URL=https://api.seudominio.com

# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-segredo-com-pelo-menos-32-chars!!
INGESTION_API_KEY=troque-por-chave-com-pelo-menos-32-chars!

ELEVENLABS_API_KEY=sk_...

# Nunca use public em produção
STORAGE_PROVIDER=minio
STORAGE_BUCKET=hq-geap-audio
STORAGE_ENDPOINT=https://minio.seudominio.com
STORAGE_ACCESS_KEY=...
STORAGE_SECRET_KEY=...
STORAGE_PUBLIC_URL=https://minio.seudominio.com/hq-geap-audio

# Depois do primeiro deploy bem-sucedido:
# SKIP_DB_SEED=1
